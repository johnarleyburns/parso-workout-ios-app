    "The app cannot stop an individual Apple-managed transfer. Use iCloud Details & Diagnostics for status, refresh, export, and legacy recovery; local history is never replaced by a failed recovery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App kann eine einzelne von Apple verwaltete Übertragung nicht stoppen. Nutze „iCloud-Details & Diagnose“ für Status, Aktualisierung, Export und Legacy-Wiederherstellung; der lokale Verlauf wird bei einer fehlgeschlagenen Wiederherstellung nie ersetzt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The app cannot stop an individual Apple-managed transfer. Use iCloud Details & Diagnostics for status, refresh, export, and legacy recovery; local history is never replaced by a failed recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La app no puede detener una transferencia concreta gestionada por Apple. Usa Detalles y diagnóstico de iCloud para el estado, la actualización, la exportación y la recuperación heredada; una recuperación fallida nunca sustituye el historial local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app ne peut pas arrêter un transfert géré par Apple. Utilisez Détails et diagnostics iCloud pour l’état, l’actualisation, l’export et la récupération héritée ; l’historique local n’est jamais remplacé par une récupération échouée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De app kan een afzonderlijke, door Apple beheerde overdracht niet stoppen. Gebruik iCloud-details en diagnose voor status, vernieuwen, exporteren en herstel uit de oude opslag; lokale geschiedenis wordt nooit vervangen door een mislukt herstel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O app não consegue interromper uma transferência específica gerenciada pela Apple. Use Detalhes e diagnóstico do iCloud para status, atualização, exportação e recuperação legada; o histórico local nunca é substituído por uma recuperação com falha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "App 无法停止单个由 Apple 管理的传输。请使用“iCloud 详细信息与诊断”查看状态、刷新、导出和旧版恢复；恢复失败绝不会替换本地历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
