    "Instructions are saved in the plan and shown as a cue when the session is reviewed or handed to a compatible execution surface." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anweisungen werden im Plan gespeichert und als Hinweis angezeigt, wenn die Einheit geprüft oder an eine kompatible Ausführungsoberfläche übergeben wird."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instructions are saved in the plan and shown as a cue when the session is reviewed or handed to a compatible execution surface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las instrucciones se guardan en el plan y se muestran como indicación al revisar la sesión o al pasarla a una superficie de ejecución compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les consignes sont enregistrées dans le plan et affichées comme indication quand la séance est revue ou transmise à une interface d’exécution compatible."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instructies worden in het plan bewaard en als hint getoond wanneer de sessie wordt bekeken of aan een compatibel uitvoeringsscherm wordt doorgegeven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As instruções são salvas no plano e exibidas como dica quando a sessão é revisada ou enviada a uma superfície de execução compatível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "说明会保存在计划中，在审核训练或交给兼容的执行界面时作为提示显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "說明會儲存在計畫中，在檢視訓練或交給相容的執行介面時作為提示顯示。"
          }
        }
      },
      "comment" : "UI text shown in: Manual Mobility Item Editor (Cadence/Cadence/Features/Home/ManualMobilityItemEditor.swift)"
