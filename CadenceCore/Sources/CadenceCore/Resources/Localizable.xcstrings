    "Lie on your back, lower back pressed down, legs and shoulders lifted into a hollow position. Hold as long as the lower back stays flat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg dich auf den Rücken, unteren Rücken in den Boden drücken, Beine und Schultern zur Hohlkörperposition anheben. Halte, solange der untere Rücken flach bleibt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lie on your back, lower back pressed down, legs and shoulders lifted into a hollow position. Hold as long as the lower back stays flat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Túmbate boca arriba con la zona lumbar pegada al suelo y eleva piernas y hombros en posición hollow. Aguanta mientras la zona lumbar siga plana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allongé sur le dos, bas du dos plaqué au sol, levez jambes et épaules en position creuse. Tenez tant que le bas du dos reste plaqué."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ga op je rug liggen, onderrug tegen de grond, benen en schouders opgetild in hollow-positie. Houd vast zolang je onderrug plat blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deite de costas com a lombar pressionada no chão e erga pernas e ombros na posição hollow. Segure enquanto a lombar continuar reta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仰卧，下背部贴地，抬起双腿和肩部呈空心姿势。在下背部保持贴地的前提下尽量坚持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仰臥，下背部貼地，抬起雙腿和肩部呈空心姿勢。在下背部維持貼地的前提下盡量撐住。"
          }
        }
      },
      "comment" : "UI text shown in: Assessment (CadenceCore/Sources/CadenceCore/Assessment.swift)"
    },
