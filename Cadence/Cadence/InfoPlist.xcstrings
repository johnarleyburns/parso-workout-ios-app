    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Info.plist NSBluetoothAlwaysUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron connects to a Bluetooth chest strap to record accurate heart rate during workouts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron verbindet sich mit einem Bluetooth-Brustgurt, um während des Trainings eine genaue Herzfrequenz aufzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron se conecta a una banda de pecho Bluetooth para registrar con precisión la frecuencia cardiaca durante los entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron se connecte à une ceinture thoracique Bluetooth pour enregistrer une fréquence cardiaque précise pendant vos entraînements."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron maakt verbinding met een Bluetooth-borstband om tijdens trainingen je hartslag nauwkeurig vast te leggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron se conecta a uma cinta peitoral Bluetooth para registrar com precisão a frequência cardíaca durante os treinos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 会连接蓝牙胸带，在训练时准确记录心率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 會連接藍牙胸帶，在訓練時準確記錄心率。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron connects to a Bluetooth chest strap to record accurate heart rate during workouts."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Info.plist NSHealthShareUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron reads your steps, workouts, heart rate, and — for recovery-aware coaching — your heart-rate variability, resting heart rate, sleep, and body weight, so your activity, Watch-recorded sessions, and readiness appear here. Cladiron stores this health data on your device and never sends it to a Cladiron server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron liest deine Schritte, Trainings, Herzfrequenz und – für erholungsbewusstes Coaching – Herzfrequenzvariabilität, Ruhepuls, Schlaf und Körpergewicht, damit deine Aktivität, auf der Watch aufgezeichnete Einheiten und deine Bereitschaft hier erscheinen. Cladiron speichert diese Gesundheitsdaten auf deinem Gerät und sendet sie niemals an einen Cladiron-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron lee tus pasos, entrenamientos, frecuencia cardiaca y, para un Coach que tenga en cuenta la recuperación, tu variabilidad de la frecuencia cardiaca, frecuencia cardiaca en reposo, sueño y peso corporal, para mostrar aquí tu actividad, las sesiones del Watch y tu preparación. Cladiron guarda estos datos de salud en tu dispositivo y nunca los envía a un servidor de Cladiron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron lit vos pas, vos entraînements, votre fréquence cardiaque et – pour un coaching attentif à la récupération – votre variabilité de la fréquence cardiaque, votre fréquence cardiaque au repos, votre sommeil et votre poids, afin d’afficher ici votre activité, les séances enregistrées sur la Watch et votre état de forme. Cladiron conserve ces données de santé sur votre appareil et ne les envoie jamais à un serveur Cladiron."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron leest je stappen, trainingen, hartslag en – voor coaching die rekening houdt met herstel – je hartslagvariabiliteit, rusthartslag, slaap en lichaamsgewicht, zodat je activiteit, op de Watch vastgelegde sessies en paraatheid hier verschijnen. Cladiron bewaart deze gezondheidsgegevens op je apparaat en stuurt ze nooit naar een Cladiron-server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron lê seus passos, treinos, frequência cardíaca e — para um Coach atento à recuperação — sua variabilidade da frequência cardíaca, frequência cardíaca em repouso, sono e peso corporal, para mostrar aqui sua atividade, as sessões gravadas no Watch e sua prontidão. O Cladiron armazena esses dados de saúde no seu dispositivo e nunca os envia a um servidor do Cladiron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 会读取你的步数、训练和心率，并为了兼顾恢复的指导读取心率变异性、静息心率、睡眠和体重，以便在此显示你的活动、手表记录的训练和准备度。Cladiron 将这些健康数据存储在你的设备上，绝不会将其发送到 Cladiron 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 會讀取你的步數、訓練和心率，並為了兼顧恢復的指導讀取心率變異度、靜止心率、睡眠和體重，以便在此顯示你的活動、手錶記錄的訓練和準備度。Cladiron 將這些健康資料儲存在你的裝置上，絕不會將其傳送到 Cladiron 伺服器。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron reads your steps, workouts, heart rate, and — for recovery-aware coaching — your heart-rate variability, resting heart rate, sleep, and body weight, so your activity, Watch-recorded sessions, and readiness appear here. Cladiron stores this health data on your device and never sends it to a Cladiron server."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Info.plist NSHealthUpdateUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron saves summaries of your workouts (strength, cardio, intervals, and swim) to Apple Health so they appear system-wide and close your Activity rings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron sichert Zusammenfassungen deiner Trainings (Kraft, Cardio, Intervalle und Schwimmen) in Apple Health, damit sie systemweit erscheinen und deine Aktivitätsringe schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron guarda en Apple Salud resúmenes de tus entrenamientos (fuerza, cardio, intervalos y natación) para que aparezcan en todo el sistema y cierren tus anillos de Actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron enregistre des résumés de vos entraînements (force, cardio, intervalles et natation) dans Apple Santé pour qu’ils apparaissent partout dans le système et ferment vos anneaux Activité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron bewaart samenvattingen van je trainingen (kracht, cardio, intervallen en zwemmen) in Apple Gezondheid, zodat ze overal in het systeem verschijnen en je Activiteitsringen sluiten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron salva resumos dos seus treinos (força, cardio, intervalos e natação) no Apple Saúde para que apareçam em todo o sistema e fechem seus anéis de Atividade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 会将你的训练摘要（力量、有氧、间歇和游泳）保存到 Apple 健康，使其在系统中显示并帮你合上活动圆环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 會將你的訓練摘要（力量、有氧、間歇和游泳）儲存到 Apple 健康，使其在系統中顯示並幫你填滿活動圓圈。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron saves summaries of your workouts (strength, cardio, intervals, and swim) to Apple Health so they appear system-wide and close your Activity rings."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Info.plist NSLocationAlwaysAndWhenInUseUsageDescription — iPhone background outdoor-workout prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron keeps recording your outdoor route while your iPhone is locked or in your pocket during a workout. It stops when the workout ends and never tracks you at other times."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron keeps recording your outdoor route while your iPhone is locked or in your pocket during a workout. It stops when the workout ends and never tracks you at other times."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron zeichnet deine Outdoor-Route weiter auf, während dein iPhone während eines Trainings gesperrt ist oder in deiner Tasche steckt. Nach dem Training wird die Aufzeichnung beendet; außerhalb von Trainings erfolgt keine Standortverfolgung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron sigue registrando tu ruta al aire libre mientras tu iPhone está bloqueado o en el bolsillo durante un entrenamiento. Se detiene al terminar el entrenamiento y nunca te rastrea en otros momentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron continue d’enregistrer votre parcours extérieur lorsque votre iPhone est verrouillé ou dans votre poche pendant un entraînement. La capture s’arrête à la fin de l’entraînement et ne vous suit jamais le reste du temps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron blijft je buitenroute opnemen terwijl je iPhone tijdens een training vergrendeld is of in je zak zit. Het stopt wanneer de training eindigt en volgt je nooit op andere momenten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron continua registrando sua rota ao ar livre enquanto seu iPhone está bloqueado ou no bolso durante um treino. Ele para quando o treino termina e nunca rastreia você em outros momentos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "训练期间，即使 iPhone 已锁定或放在口袋里，Cladiron 也会继续记录你的户外路线。训练结束后停止记录，绝不会在其他时间跟踪你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "訓練期間，即使 iPhone 已鎖定或放在口袋裡，Cladiron 也會繼續記錄你的戶外路線。訓練結束後停止記錄，絕不會在其他時間追蹤你。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist NSLocationWhenInUseUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron uses your location to map and measure outdoor runs and rides recorded on your iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron nutzt deinen Standort, um Läufe und Radfahrten im Freien, die du mit dem iPhone aufzeichnest, zu kartieren und zu messen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron usa tu ubicación para trazar y medir las carreras y rutas en bici al aire libre que registras con el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron utilise votre position pour cartographier et mesurer les courses et sorties à vélo en extérieur enregistrées sur votre iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron gebruikt je locatie om hardloop- en fietstochten buiten die je met je iPhone vastlegt in kaart te brengen en te meten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron usa sua localização para mapear e medir corridas e pedais ao ar livre registrados no seu iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 会使用你的位置来绘制和测量在 iPhone 上记录的户外跑步与骑行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 會使用你的位置來繪製和測量在 iPhone 上記錄的戶外跑步與騎車。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron uses your location to map and measure outdoor runs and rides recorded on your iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist NSMicrophoneUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron uses the microphone only when you choose Quick Talk to log a workout hands-free."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron nutzt das Mikrofon nur, wenn du Quick Talk wählst, um ein Training freihändig zu protokollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron solo usa el micrófono cuando eliges Quick Talk para registrar un entrenamiento sin manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron n’utilise le micro que lorsque vous choisissez Quick Talk pour enregistrer un entraînement mains libres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron gebruikt de microfoon alleen als je Quick Talk kiest om handsfree een training te loggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron só usa o microfone quando você escolhe o Quick Talk para registrar um treino sem usar as mãos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 仅在你选择 Quick Talk 免手动记录训练时使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 僅在你選擇 Quick Talk 免手動記錄訓練時使用麥克風。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron uses the microphone only when you choose Quick Talk to log a workout hands-free."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Info.plist NSSpeechRecognitionUsageDescription — iPhone app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron transcribes your spoken workout command so you can review it before anything is logged."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron transkribiert deinen gesprochenen Trainingsbefehl, damit du ihn prüfen kannst, bevor etwas protokolliert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron transcribe tu comando de voz para que puedas revisarlo antes de registrar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron transcrit votre commande vocale pour que vous puissiez la vérifier avant tout enregistrement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron zet je gesproken trainingsopdracht om in tekst, zodat je die kunt controleren voordat er iets wordt gelogd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron transcreve seu comando de voz para que você possa revisá-lo antes de qualquer registro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 会转写你的语音训练指令，让你在记录前确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron 會轉錄你的語音訓練指令，讓你在記錄前確認。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron transcribes your spoken workout command so you can review it before anything is logged."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
