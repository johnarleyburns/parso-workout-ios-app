#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ "${SKIP_LOCAL_GUARDS:-}" == "1" ]]; then
  echo "pre-commit: SKIP_LOCAL_GUARDS=1 set; skipping unit tests"
  exit 0
fi

echo "pre-commit: running SwiftPM unit tests and simulator smoke test"
make pre-commit
