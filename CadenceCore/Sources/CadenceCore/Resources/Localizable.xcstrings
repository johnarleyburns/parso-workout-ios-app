    "Do as many bodyweight squats as you can in one set at a steady cadence, hips below parallel each rep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mach so viele Kniebeugen ohne Gewicht wie möglich in einem Satz, in gleichmäßigem Tempo, bei jeder Wiederholung mit der Hüfte unter Parallel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Do as many bodyweight squats as you can in one set at a steady cadence, hips below parallel each rep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz tantas sentadillas con peso corporal como puedas en una serie a ritmo constante, con la cadera por debajo de la paralela en cada repetición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites autant de squats au poids du corps que possible en une série, à cadence régulière, hanches sous la parallèle à chaque répétition."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doe zoveel mogelijk squats met lichaamsgewicht in één set, in een gelijkmatig tempo, met de heupen elke herhaling onder parallel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça o máximo de agachamentos com peso corporal que conseguir em uma série, em ritmo constante, com o quadril abaixo da linha paralela em cada repetição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以稳定节奏一组内尽可能多地做自重深蹲，每次髋部低于平行位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以穩定節奏一組內盡可能多地做自體重量深蹲，每下髖部低於水平位置。"
          }
        }
      },
      "comment" : "UI text shown in: Assessment (CadenceCore/Sources/CadenceCore/Assessment.swift)"
    },
    "Do as many strict, dead-hang pull-ups as you can in one set — full extension at the bottom, chin over the bar at the top, no kipping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mach so viele saubere Klimmzüge aus dem toten Hang wie möglich in einem Satz – unten volle Streckung, oben Kinn über der Stange, kein Schwung."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Do as many strict, dead-hang pull-ups as you can in one set — full extension at the bottom, chin over the bar at the top, no kipping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz tantas dominadas estrictas desde colgado como puedas en una serie: extensión completa abajo, barbilla sobre la barra arriba, sin balanceo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites autant de tractions strictes bras tendus que possible en une série – extension complète en bas, menton au-dessus de la barre en haut, sans élan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doe zoveel mogelijk strikte pull-ups vanuit dood hangen in één set – onderin volledig gestrekt, bovenin kin boven de stang, geen zwaai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça o máximo de barras estritas a partir da posição pendurada que conseguir em uma série — extensão completa embaixo, queixo acima da barra em cima, sem balanço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一组内尽可能多地做标准悬垂引体向上——底部手臂完全伸直，顶部下巴过杠，不借力摆动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一組內盡可能多地做標準懸垂引體向上——底部手臂完全打直，頂端下巴過槓，不借力擺盪。"
          }
        }
      },
      "comment" : "UI text shown in: Assessment (CadenceCore/Sources/CadenceCore/Assessment.swift)"
    },
