        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le paquet ouvert free-exercise-db-plusplus est figé à la version %@. L’interface de Cladiron, la composition du coaching propre à l’app, la persistance, l’intégration HealthKit et les expériences sur les plateformes Apple sont couvertes par les conditions GPLv3 ou ultérieure et l’exception App Store ci-dessus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het open pakket free-exercise-db-plusplus is vastgezet op versie %@. De interface van Cladiron, de app-specifieke coachingopbouw, opslag, HealthKit-integratie en Apple-platformervaringen vallen onder de bovenstaande voorwaarden van GPLv3-of-later en de App Store-uitzondering."
          }
        },
