      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron saves your workout summary to Health."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron sichert deine Trainingszusammenfassung in Health."
          }
        },
        "es" : {
          "stringUnit" : {
