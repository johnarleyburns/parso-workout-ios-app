    "Your logged workouts are enough for habit, volume, and lift-history trends. A separate e1RM or rep-max test gives Coach a measured strength baseline for percentage-based load targets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine protokollierten Trainings reichen für Gewohnheits-, Volumen- und Übungsverläufe. Ein separater e1RM- oder Wiederholungsmaximum-Test gibt dem Coach einen gemessenen Kraft-Ausgangswert für prozentbasierte Lastziele."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your logged workouts are enough for habit, volume, and lift-history trends. A separate e1RM or rep-max test gives Coach a measured strength baseline for percentage-based load targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus entrenamientos registrados bastan para las tendencias de hábito, volumen e historial de levantamientos. Una prueba aparte de e1RM o de repeticiones máximas da al Coach una referencia de fuerza medida para objetivos de carga en porcentaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos entraînements enregistrés suffisent pour les tendances d’habitude, de volume et d’historique des mouvements. Un test e1RM ou de répétitions max distinct donne au Coach une référence de force mesurée pour les objectifs de charge en pourcentage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je gelogde trainingen zijn genoeg voor trends in gewoonte, volume en liftgeschiedenis. Een aparte e1RM- of herhalingsmaximumtest geeft de coach een gemeten krachtnulmeting voor procentuele belastingsdoelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seus treinos registrados bastam para tendências de hábito, volume e histórico de levantamentos. Um teste separado de e1RM ou repetições máximas dá ao Coach uma referência de força medida para metas de carga em porcentagem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你记录的训练足以分析习惯、训练量和动作历史趋势。单独的 e1RM 或最大次数测试可为教练提供实测力量基线，用于基于百分比的负荷目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你記錄的訓練足以分析習慣、訓練量和動作紀錄趨勢。單獨的 e1RM 或最大次數測驗可為教練提供實測力量基準，用於依百分比的負荷目標。"
          }
        }
      },
      "comment" : "UI text shown in: Recommendation Rule (CadenceCore/Sources/CadenceCore/RecommendationRule.swift)"
    },
    "Your logged workouts are enough for volume and habit trends. A separate e1RM or rep-max test gives Coach a measured strength baseline, which unlocks percentage-based load targets and cleaner retest comparisons." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine protokollierten Trainings reichen für Volumen- und Gewohnheitsverläufe. Ein separater e1RM- oder Wiederholungsmaximum-Test gibt dem Coach einen gemessenen Kraft-Ausgangswert, der prozentbasierte Lastziele und sauberere Vergleiche bei Wiederholungstests ermöglicht."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your logged workouts are enough for volume and habit trends. A separate e1RM or rep-max test gives Coach a measured strength baseline, which unlocks percentage-based load targets and cleaner retest comparisons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
