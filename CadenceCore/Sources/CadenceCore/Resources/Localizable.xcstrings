    "The coach uses experience-scaled starting landmarks and spreads volume rather than maximizing one session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Coach nutzt nach Erfahrung skalierte Startwerte und verteilt das Volumen, statt eine Einheit zu maximieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The coach uses experience-scaled starting landmarks and spreads volume rather than maximising one session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Coach usa referencias iniciales ajustadas a tu experiencia y reparte el volumen en lugar de concentrarlo en una sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Coach utilise des repères de départ adaptés à l’expérience et répartit le volume au lieu de maximiser une seule séance."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De coach gebruikt startwaarden op basis van ervaring en verdeelt volume in plaats van één sessie te maximaliseren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coach usa referências iniciais ajustadas à experiência e distribui o volume em vez de maximizar uma sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "教练使用按经验调整的起始基准，并分散训练量，而非堆在一次训练中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "教練使用依經驗調整的起始基準，並分散訓練量，而非堆在一次訓練中。"
          }
