    "Adds each winning movement with your set preference, then trims from the end to a %lld-set safety cap and recomputes what is still uncovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fügt jede ausgewählte Bewegung mit deiner Satzvorgabe hinzu, kürzt dann vom Ende her auf eine Sicherheitsgrenze von %lld Sätzen und berechnet neu, was noch offen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade cada movimiento elegido con tu preferencia de series, luego recorta desde el final hasta un tope de seguridad de %lld series y recalcula lo que aún queda por cubrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoute chaque mouvement retenu avec votre préférence de séries, puis réduit depuis la fin jusqu’à un plafond de sécurité de %lld séries et recalcule ce qui reste à couvrir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voegt elke gekozen beweging toe met je setvoorkeur, kort daarna vanaf het einde in tot een veiligheidslimiet van %lld sets en berekent opnieuw wat nog openstaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adiciona cada movimento escolhido com sua preferência de séries, depois corta a partir do fim até um limite de segurança de %lld séries e recalcula o que ainda falta cobrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按你的组数偏好添加每个选中的动作，然后从末尾裁减到 %lld 组的安全上限，并重新计算仍未覆盖的部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "依你的組數偏好加入每個選中的動作，再從末尾刪減到 %lld 組的安全上限，並重新計算仍未涵蓋的部分。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adds each winning movement with your set preference, then trims from the end to a %lld-set safety cap and recomputes what is still uncovered."
          }
        }
      }
    },
