        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digite o peso de um kettlebell. O app considera movimentos com dois kettlebells e com um só nos cálculos.\n\nEm exercícios comuns com dois kettlebells (cleans duplos, desenvolvimentos duplos, agachamentos frontais etc.), o peso digitado é dobrado automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
