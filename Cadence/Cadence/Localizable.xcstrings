          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fuerza: favorece cargas pesadas (≥ 80 % e1RM). Hipertrofia: apunta a cargas moderadas con RIR controlado. Resistencia: señala el exceso de trabajo pesado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Force : privilégie les charges lourdes (≥ 80 % e1RM). Hypertrophie : vise des charges modérées avec un RIR contrôlé. Endurance : signale un excès de travail lourd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kracht: geeft voorkeur aan zware gewichten (≥ 80% e1RM). Hypertrofie: richt zich op matige gewichten met gecontroleerde RIR. Uithouding: markeert overmatig zwaar werk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
