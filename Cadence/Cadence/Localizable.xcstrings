    "JSON is the lossless backup for a new device. FIT is for cardio/activity exchange; it intentionally does not contain strength sets or preferences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JSON ist das verlustfreie Backup für ein neues Gerät. FIT dient dem Austausch von Cardio-/Aktivitätsdaten und enthält bewusst keine Kraftsätze oder Einstellungen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JSON is the lossless backup for a new device. FIT is for cardio/activity exchange; it intentionally does not contain strength sets or preferences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JSON es la copia sin pérdidas para un dispositivo nuevo. FIT sirve para intercambiar cardio/actividad y no incluye a propósito series de fuerza ni preferencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le JSON est la sauvegarde sans perte pour un nouvel appareil. Le FIT sert à l’échange de cardio/activité et ne contient volontairement ni séries de force ni préférences."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
