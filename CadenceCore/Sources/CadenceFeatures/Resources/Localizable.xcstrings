          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma frequência cardíaca chegou do seu Apple Watch. Verifique se ele está no pulso e desbloqueado e toque em “Verificar FC ao vivo”."
