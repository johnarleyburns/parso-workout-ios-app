    "Exact recovery windows per exercise, movement pattern, and muscle group — unlike calendar-week snapshots, these don't shift at midnight Monday." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genaue Erholungsfenster pro Übung, Bewegungsmuster und Muskelgruppe – anders als Kalenderwochen-Momentaufnahmen verschieben sie sich nicht Montag um Mitternacht."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exact recovery windows per exercise, movement pattern, and muscle group — unlike calendar-week snapshots, these don't shift at midnight Monday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ventanas de recuperación exactas por ejercicio, patrón de movimiento y grupo muscular; a diferencia de las instantáneas por semana natural, no cambian a medianoche del lunes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des fenêtres de récupération précises par exercice, schéma moteur et groupe musculaire – contrairement aux instantanés par semaine calendaire, elles ne basculent pas le lundi à minuit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exacte herstelvensters per oefening, bewegingspatroon en spiergroep – anders dan momentopnamen per kalenderweek verschuiven ze niet op maandag om middernacht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Janelas de recuperação exatas por exercício, padrão de movimento e grupo muscular — ao contrário de recortes por semana do calendário, elas não mudam à meia-noite de segunda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按动作、动作模式和肌群精确计算恢复间隔——不同于按自然周统计，它们不会在周一零点突然变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "依動作、動作模式和肌群精確計算恢復間隔——不同於依日曆週統計，它們不會在週一午夜突然變化。"
          }
        }
      },
