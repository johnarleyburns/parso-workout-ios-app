    "Consider interval work: options include a Norwegian 4×4 session (4×4 min hard / 3 min recovery) or shorter long-interval protocols, paired with your usual training." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erwäge Intervalltraining: etwa eine norwegische 4×4-Einheit (4×4 Min. hart / 3 Min. Erholung) oder kürzere Protokolle mit langen Intervallen, kombiniert mit deinem üblichen Training."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consider interval work: options include a Norwegian 4×4 session (4×4 min hard / 3 min recovery) or shorter long-interval protocols, paired with your usual training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plantéate trabajo de intervalos: por ejemplo, una sesión noruega 4×4 (4×4 min duros / 3 min de recuperación) o protocolos más cortos de intervalos largos, junto a tu entrenamiento habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envisagez du fractionné : par exemple une séance norvégienne 4×4 (4×4 min intenses / 3 min de récupération) ou des protocoles plus courts d’intervalles longs, en plus de votre entraînement habituel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overweeg intervaltraining: bijvoorbeeld een Noorse 4×4-sessie (4×4 min zwaar / 3 min herstel) of kortere protocollen met lange intervallen, naast je gebruikelijke training."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Considere treino intervalado: por exemplo, uma sessão norueguesa 4×4 (4×4 min forte / 3 min de recuperação) ou protocolos mais curtos de intervalos longos, junto com seu treino habitual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "考虑间歇训练：例如挪威 4×4 训练（4×4 分钟高强度 / 3 分钟恢复）或更短的长间歇方案，与常规训练搭配进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "考慮間歇訓練：例如挪威 4×4 訓練（4×4 分鐘高強度／3 分鐘恢復）或更短的長間歇方案，與平常的訓練搭配進行。"
          }
        }
      },
