#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ "${SKIP_LOCAL_GUARDS:-}" == "1" ]]; then
  echo "pre-commit: SKIP_LOCAL_GUARDS=1 set; skipping local guards"
  exit 0
fi

echo "pre-commit: running SwiftPM package tests only (no simulator)"
# Same as `make resolve-dbpp`: a re-resolved DB++ 1.17.0 checkout needs the
# HealthInterop compatibility patch before it compiles.
swift package resolve --package-path CadenceCore
bash scripts/patch-dbpp-healthinterop.sh
swift test --package-path CadenceCore --parallel --num-workers 1
