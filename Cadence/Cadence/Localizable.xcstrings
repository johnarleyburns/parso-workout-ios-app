    "Your coach uses goal and experience to tailor insights. Steps target is 8,000/day by default; the fixed health floor is 4,000/day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Coach passt Erkenntnisse an Ziel und Erfahrung an. Das Schrittziel liegt standardmäßig bei 8.000/Tag; die feste Gesundheitsuntergrenze bei 4.000/Tag."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your coach uses goal and experience to tailor insights. Steps target is 8,000/day by default; the fixed health floor is 4,000/day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu Coach usa tu objetivo y experiencia para adaptar las observaciones. El objetivo de pasos es de 8000/día por defecto; el mínimo de salud fijo es de 4000/día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre Coach adapte les observations à votre objectif et à votre expérience. L’objectif de pas est de 8 000/jour par défaut ; le seuil de santé fixe est de 4 000/jour."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je coach stemt inzichten af op je doel en ervaring. Het stappendoel is standaard 8.000/dag; de vaste gezondheidsondergrens is 4.000/dag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seu Coach usa objetivo e experiência para adaptar os insights. A meta de passos é 8.000/dia por padrão; o mínimo fixo de saúde é 4.000/dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "教练会根据你的目标和经验调整洞察。步数目标默认为每天 8,000 步；固定健康下限为每天 4,000 步。"
          }
