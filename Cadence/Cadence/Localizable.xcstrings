          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez que vous portez la ceinture thoracique, que les électrodes sont humides et que la ceinture est à portée. Certaines ceintures demandent d’humidifier les électrodes avant chaque utilisation."
          }
        },
        "nl" : {
          "stringUnit" : {
