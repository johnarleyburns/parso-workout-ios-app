    "Coach needs %@ today. These options satisfy the target or come closest while respecting recovery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Coach braucht heute %@. Diese Optionen erfüllen das Ziel oder kommen ihm am nächsten, ohne die Erholung zu missachten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach needs %@ today. These options satisfy the target or come closest while respecting recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Coach necesita %@ hoy. Estas opciones cumplen el objetivo o se acercan más respetando la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Coach a besoin de %@ aujourd’hui. Ces options atteignent l’objectif ou s’en approchent le plus tout en respectant la récupération."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De coach heeft vandaag %@ nodig. Deze opties halen het doel of komen het dichtst in de buurt, met respect voor herstel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coach precisa de %@ hoje. Estas opções cumprem a meta ou chegam mais perto, respeitando a recuperação."
          }
