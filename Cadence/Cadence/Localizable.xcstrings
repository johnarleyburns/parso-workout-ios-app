    "Choose a Cladiron backup (.json.gz or .json), or a FIT activity file. JSON restores the complete backup; FIT imports cardio activity data and merges it with your existing history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle ein Cladiron-Backup (.json.gz oder .json) oder eine FIT-Aktivitätsdatei. JSON stellt das vollständige Backup wieder her; FIT importiert Cardio-Aktivitätsdaten und führt sie mit deinem bestehenden Verlauf zusammen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choose a Cladiron backup (.json.gz or .json), or a FIT activity file. JSON restores the complete backup; FIT imports cardio activity data and merges it with your existing history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige una copia de Cladiron (.json.gz o .json) o un archivo de actividad FIT. JSON restaura la copia completa; FIT importa datos de actividad de cardio y los combina con tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez une sauvegarde Cladiron (.json.gz ou .json) ou un fichier d’activité FIT. Le JSON restaure la sauvegarde complète ; le FIT importe des données d’activité cardio et les fusionne avec votre historique."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies een Cladiron-reservekopie (.json.gz of .json) of een FIT-activiteitsbestand. JSON herstelt de volledige reservekopie; FIT importeert cardioactiviteitsgegevens en voegt ze samen met je bestaande geschiedenis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha um backup do Cladiron (.json.gz ou .json) ou um arquivo de atividade FIT. O JSON restaura o backup completo; o FIT importa dados de atividade de cardio e os mescla com seu histórico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择 Cladiron 备份（.json.gz 或 .json）或 FIT 活动文件。JSON 会恢复完整备份；FIT 会导入有氧活动数据并与现有历史合并。"
          }
        },
        "zh-Hant" : {
