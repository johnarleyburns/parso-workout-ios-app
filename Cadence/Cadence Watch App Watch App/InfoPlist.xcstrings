    "NSHealthShareUsageDescription" : {
      "comment" : "Info.plist NSHealthShareUsageDescription — Apple Watch app permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cladiron reads heart rate from your Apple Watch during workouts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron liest während des Trainings die Herzfrequenz von deiner Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron lee la frecuencia cardiaca de tu Apple Watch durante los entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron lit la fréquence cardiaque de votre Apple Watch pendant les entraînements."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cladiron leest tijdens trainingen de hartslag van je Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Cladiron lê a frequência cardíaca do seu Apple Watch durante os treinos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
