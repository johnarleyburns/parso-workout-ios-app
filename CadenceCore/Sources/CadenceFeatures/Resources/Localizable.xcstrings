            "value" : "Berücksichtigt zuerst die größte verbleibende Lücke; bei gleichen Lücken gilt eine feste Reihenfolge von großen zu kleinen Muskeln."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Considers the largest remaining gap first; equal gaps use a fixed largest-to-smallest muscle order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Considera primero la mayor brecha restante; si hay empate, usa un orden fijo de músculos de mayor a menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traite d’abord le plus grand manque restant ; à égalité, un ordre fixe des plus grands aux plus petits muscles s’applique."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kijkt eerst naar het grootste resterende tekort; bij gelijke tekorten geldt een vaste volgorde van grote naar kleine spieren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
