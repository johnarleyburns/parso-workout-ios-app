#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ "${SKIP_LOCAL_GUARDS:-}" == "1" ]]; then
  echo "pre-push: SKIP_LOCAL_GUARDS=1 set; skipping local full test gate"
  exit 0
fi

echo "pre-push: running SwiftPM unit tests and simulator smoke test"
make pre-push
