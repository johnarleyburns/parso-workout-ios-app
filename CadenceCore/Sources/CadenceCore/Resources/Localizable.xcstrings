    "Tracked as a personal benchmark — no population-validated equation maps this to a lab measure. Compare yourself to yourself over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als persönlicher Richtwert erfasst – keine an der Bevölkerung validierte Formel überträgt dies auf einen Labormesswert. Vergleiche dich mit dir selbst über die Zeit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tracked as a personal benchmark — no population-validated equation maps this to a lab measure. Compare yourself to yourself over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se registra como referencia personal: ninguna ecuación validada en la población lo traduce a una medición de laboratorio. Compárate contigo mismo a lo largo del tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suivi comme repère personnel – aucune équation validée sur la population ne le relie à une mesure de laboratoire. Comparez-vous à vous-même dans le temps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gevolgd als persoonlijke maatstaf – geen op de bevolking gevalideerde formule koppelt dit aan een labmeting. Vergelijk jezelf met jezelf door de tijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acompanhado como referência pessoal — nenhuma equação validada na população converte isso numa medida de laboratório. Compare-se com você mesmo ao longo do tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "作为个人基准追踪——没有经人群验证的公式可将其换算为实验室测量值。请与过去的自己比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
