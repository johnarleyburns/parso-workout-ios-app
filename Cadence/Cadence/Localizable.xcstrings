    "Scales weekly starting volume ranges per muscle group. Beginners usually need fewer sets; advanced lifters often tolerate more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skaliert die wöchentlichen Startbereiche für das Volumen pro Muskelgruppe. Einsteiger brauchen meist weniger Sätze; Fortgeschrittene vertragen oft mehr."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scales weekly starting volume ranges per muscle group. Beginners usually need fewer sets; advanced lifters often tolerate more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajusta los rangos de volumen semanal inicial por grupo muscular. Los principiantes suelen necesitar menos series; los avanzados suelen tolerar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajuste les fourchettes de volume hebdomadaire de départ par groupe musculaire. Les débutants ont généralement besoin de moins de séries ; les pratiquants avancés en tolèrent souvent davantage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schaalt de wekelijkse startbereiken voor volume per spiergroep. Beginners hebben meestal minder sets nodig; gevorderden verdragen er vaak meer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajusta as faixas de volume semanal inicial por grupo muscular. Iniciantes geralmente precisam de menos séries; avançados costumam tolerar mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按肌群调整每周起始训练量范围。新手通常需要较少组数；进阶者往往能承受更多。"
