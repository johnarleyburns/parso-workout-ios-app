    "Guarantees the coach behaves predictably — deleted or future-dated training never pollutes the recommendation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stellt sicher, dass sich der Coach vorhersehbar verhält – gelöschtes oder zukünftig datiertes Training verfälscht nie die Empfehlung."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guarantees the coach behaves predictably — deleted or future-dated training never pollutes the recommendation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garantiza que el Coach se comporte de forma predecible: el entrenamiento eliminado o con fecha futura nunca contamina la recomendación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garantit un comportement prévisible du Coach – un entraînement supprimé ou daté dans le futur ne fausse jamais la recommandation."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zorgt dat de coach voorspelbaar werkt – verwijderde of toekomstige trainingen beïnvloeden het advies nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garante que o Coach se comporte de forma previsível — treinos apagados ou com data futura nunca contaminam a recomendação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "确保教练行为可预测——已删除或未来日期的训练绝不会干扰建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "確保教練行為可預測——已刪除或未來日期的訓練絕不會干擾建議。"
          }
