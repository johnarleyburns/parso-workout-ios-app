    "The coach recomputes from scratch every time the Home screen renders. There is no cache — it always reflects the current state of your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Coach rechnet bei jedem Anzeigen der Startseite neu. Es gibt keinen Cache – er spiegelt immer den aktuellen Stand deiner Daten wider."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The coach recomputes from scratch every time the Home screen renders. There is no cache — it always reflects the current state of your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Coach recalcula desde cero cada vez que se muestra Inicio. No hay caché: siempre refleja el estado actual de tus datos."
