    },
    "Actual exercise minutes, guideline credit, training-zone time, and standardized MET-minutes are separate axes. MET-minutes describe population-level activity dose and do not replace guideline credit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tatsächliche Bewegungsminuten, Richtlinien-Anrechnung, Zeit in Trainingszonen und standardisierte MET-Minuten sind getrennte Achsen. MET-Minuten beschreiben die Aktivitätsdosis auf Bevölkerungsebene und ersetzen keine Richtlinien-Anrechnung."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Actual exercise minutes, guideline credit, training-zone time, and standardised MET-minutes are separate axes. MET-minutes describe population-level activity dose and do not replace guideline credit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los minutos de ejercicio reales, el cómputo para las pautas, el tiempo en zonas de entrenamiento y los MET-minutos estandarizados son ejes distintos. Los MET-minutos describen la dosis de actividad a nivel poblacional y no sustituyen el cómputo para las pautas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les minutes d’exercice réelles, le crédit au regard des recommandations, le temps en zones d’entraînement et les MET-minutes standardisées sont des axes distincts. Les MET-minutes décrivent une dose d’activité à l’échelle de la population et ne remplacent pas le crédit des recommandations."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Werkelijke bewegingsminuten, richtlijntelling, tijd in trainingszones en gestandaardiseerde MET-minuten zijn aparte assen. MET-minuten beschrijven de activiteitsdosis op bevolkingsniveau en vervangen de richtlijntelling niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutos reais de exercício, contagem para as diretrizes, tempo em zonas de treino e MET-minutos padronizados são eixos separados. MET-minutos descrevem a dose de atividade em nível populacional e não substituem a contagem para as diretrizes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "实际运动分钟数、指南额度、训练区间时间和标准化 MET 分钟是相互独立的维度。MET 分钟描述的是人群层面的活动剂量，不能替代指南额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "實際運動分鐘數、指南額度、訓練區間時間和標準化 MET 分鐘是彼此獨立的面向。MET 分鐘描述的是族群層面的活動劑量，不能取代指南額度。"
          }
        }
      },
      "comment" : "UI text shown in: Settings Coach And Cardios (Cadence/Cadence/Features/Settings/SettingsCoachAndCardioViews.swift)"
    },
