        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De coach vult eerst het grootste wekelijkse tekort – krachtdagen of duurminuten – en toont zwaardere opties zodra de basis op orde is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coach fecha primeiro o maior déficit da semana — dias de força ou minutos aeróbicos — e depois mostra opções mais duras quando o básico está coberto."
