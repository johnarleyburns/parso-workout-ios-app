    "Strength: favors heavy loads (>=80% e1RM). Hypertrophy: targets moderate loads with controlled RIR. Endurance: flags excessive heavy work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kraft: bevorzugt schwere Lasten (≥ 80 % e1RM). Hypertrophie: zielt auf mittlere Lasten mit kontrollierten RIR. Ausdauer: markiert übermäßige schwere Arbeit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
