    "Add easy-to-moderate aerobic work: 20–45 min of steady effort. Build the habit and the duration first; intensity can come later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge lockere bis moderate Ausdauereinheiten hinzu: 20–45 Min. gleichmäßige Belastung. Baue zuerst Gewohnheit und Dauer auf; die Intensität kann später kommen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Add easy-to-moderate aerobic work: 20–45 min of steady effort. Build the habit and the duration first; intensity can come later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade trabajo aeróbico suave a moderado: 20–45 min de esfuerzo constante. Crea primero el hábito y la duración; la intensidad puede venir después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez de l’aérobie léger à modéré : 20–45 min d’effort régulier. Installez d’abord l’habitude et la durée ; l’intensité viendra ensuite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg rustige tot matige aerobe training toe: 20–45 min gelijkmatige inspanning. Bouw eerst de gewoonte en de duur op; intensiteit komt later."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione atividade aeróbica leve a moderada: 20–45 min de esforço constante. Construa primeiro o hábito e a duração; a intensidade pode vir depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "增加轻松到中等的有氧训练：20–45 分钟稳定强度。先培养习惯和时长，强度之后再提高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "增加輕鬆到中等的有氧訓練：20–45 分鐘穩定強度。先培養習慣和時長，強度之後再提高。"
          }
        }
      },
      "comment" : "UI text shown in: Coach Rule Support (CadenceCore/Sources/CadenceCore/CoachRuleSupport.swift)"
    },
    "Add or substitute a movement only if it fits the user's equipment and constraints." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge eine Bewegung nur hinzu oder ersetze sie nur, wenn sie zur Ausrüstung und zu den Einschränkungen der Person passt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Add or substitute a movement only if it fits the user's equipment and constraints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade o sustituye un movimiento solo si encaja con el equipo y las limitaciones de la persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’ajoutez ou ne remplacez un mouvement que s’il convient au matériel et aux contraintes de la personne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg een beweging alleen toe of vervang die alleen als die past bij de uitrusting en beperkingen van de gebruiker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione ou substitua um movimento somente se ele se encaixar no equipamento e nas restrições da pessoa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅在符合用户器械和限制条件时添加或替换动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "僅在符合使用者器材和限制條件時新增或替換動作。"
          }
        }
      },
      "comment" : "UI text shown in: Unified Plan Coach (CadenceCore/Sources/CadenceCore/UnifiedPlanCoach.swift)"
    },
    "Add short all-out efforts only if you feel ready today: e.g. 4–6 × 20–30 s sprints with full recovery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge kurze Maximalsprints nur hinzu, wenn du dich heute bereit fühlst: z. B. 4–6 × 20–30 s mit vollständiger Erholung."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Add short all-out efforts only if you feel ready today: e.g. 4–6 × 20–30 s sprints with full recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade esfuerzos cortos al máximo solo si hoy te sientes preparado: p. ej., 4–6 sprints de 20–30 s con recuperación completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’ajoutez de courts efforts à fond que si vous vous sentez prêt aujourd’hui : par ex. 4–6 sprints de 20–30 s avec récupération complète."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg korte maximale inspanningen alleen toe als je je vandaag klaar voelt: bijv. 4–6 × 20–30 s sprints met volledig herstel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione esforços curtos no máximo só se você se sentir pronto hoje: por exemplo, 4–6 tiros de 20–30 s com recuperação completa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只有在今天感觉状态好时才加入短时全力冲刺：例如 4–6 次 20–30 秒冲刺，充分恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只有在今天感覺狀態好時才加入短時全力衝刺：例如 4–6 次 20–30 秒衝刺，充分恢復。"
          }
        }
      },
      "comment" : "UI text shown in: Coach Rule Support (CadenceCore/Sources/CadenceCore/CoachRuleSupport.swift)"
    },
