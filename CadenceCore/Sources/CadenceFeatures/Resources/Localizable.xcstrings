        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Von deiner Apple Watch kam keine Herzfrequenz. Prüfe, ob sie am Handgelenk und entsperrt ist, und tippe dann auf „Live-HF prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
