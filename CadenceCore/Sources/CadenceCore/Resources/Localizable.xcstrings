    "Accumulate moderate aerobic work toward the 150 min/week floor: brisk walking, easy cycling, swimming, or any steady-effort activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammle moderate Ausdauereinheiten bis zum Minimum von 150 Min./Woche: zügiges Gehen, lockeres Radfahren, Schwimmen oder jede gleichmäßige Aktivität."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accumulate moderate aerobic work toward the 150 min/week floor: brisk walking, easy cycling, swimming, or any steady-effort activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acumula trabajo aeróbico moderado hasta el mínimo de 150 min/semana: caminar a paso ligero, pedalear suave, nadar o cualquier actividad de esfuerzo constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cumulez de l’activité aérobie modérée jusqu’au plancher de 150 min/semaine : marche rapide, vélo tranquille, natation ou toute activité à effort régulier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verzamel matige aerobe activiteit tot het minimum van 150 min/week: stevig wandelen, rustig fietsen, zwemmen of elke activiteit met gelijkmatige inspanning."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acumule atividade aeróbica moderada até o mínimo de 150 min/semana: caminhada rápida, pedal leve, natação ou qualquer atividade de esforço constante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "累积中等强度有氧活动，达到每周 150 分钟的下限：快走、轻松骑车、游泳或任何稳定强度的活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "累積中等強度有氧活動，達到每週 150 分鐘的下限：快走、輕鬆騎車、游泳或任何穩定強度的活動。"
          }
        }
      },
      "comment" : "UI text shown in: Recommendation Rule (CadenceCore/Sources/CadenceCore/RecommendationRule.swift)"
    },
