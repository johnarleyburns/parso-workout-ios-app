    "Hold a forearm plank with a flat back and braced core for as long as form stays solid. Stop the clock when your hips sag or rise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte einen Unterarmstütz mit geradem Rücken und angespanntem Rumpf, so lange die Technik sauber bleibt. Stoppe die Zeit, wenn die Hüfte absinkt oder nach oben geht."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold a forearm plank with a flat back and braced core for as long as form stays solid. Stop the clock when your hips sag or rise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén una plancha sobre antebrazos con la espalda recta y el core activo mientras la técnica sea sólida. Para el reloj cuando la cadera baje o suba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tenez la planche sur les avant-bras, dos plat et gainage serré, tant que la forme reste solide. Arrêtez le chrono quand les hanches s’affaissent ou remontent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd een onderarmplank met een rechte rug en aangespannen core zolang de vorm goed blijft. Stop de klok als je heupen zakken of omhoog gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha uma prancha nos antebraços com as costas retas e o core firme enquanto a postura estiver boa. Pare o cronômetro quando o quadril cair ou subir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "保持前臂平板支撑，背部平直、核心收紧，在姿势标准的前提下尽量坚持。臀部下沉或抬起时停止计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "維持前臂棒式，背部平直、核心收緊，在姿勢標準的前提下盡量撐住。臀部下沉或抬起時停止計時。"
          }
        }
      },
      "comment" : "UI text shown in: Assessment (CadenceCore/Sources/CadenceCore/Assessment.swift)"
    },
    "Hold or reduce the next exposure after repeated decline." : {
      "localizations" : {
