    },
    "Named after Martin Gibala's sprint-interval research. 60 s of hard work alternates with 60 s of recovery for 8 rounds, totalling ~20 min. Produces metabolic adaptations comparable to much longer moderate-intensity training." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Benannt nach der Sprintintervall-Forschung von Martin Gibala. 60 s harte Arbeit wechseln sich über 8 Runden mit 60 s Erholung ab, insgesamt ~20 Min. Erzeugt Stoffwechselanpassungen, die mit viel längerem moderatem Training vergleichbar sind."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Named after Martin Gibala's sprint-interval research. 60 s of hard work alternates with 60 s of recovery for 8 rounds, totalling ~20 min. Produces metabolic adaptations comparable to much longer moderate-intensity training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recibe su nombre por la investigación de Martin Gibala sobre intervalos de esprint. 60 s de trabajo duro alternan con 60 s de recuperación durante 8 rondas, unos 20 min en total. Produce adaptaciones metabólicas comparables a entrenamientos moderados mucho más largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nommé d’après les travaux de Martin Gibala sur le fractionné en sprint. 60 s d’effort intense alternent avec 60 s de récupération sur 8 tours, soit ~20 min au total. Produit des adaptations métaboliques comparables à un entraînement modéré bien plus long."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vernoemd naar het sprintintervalonderzoek van Martin Gibala. 60 s zwaar werk wisselt af met 60 s herstel over 8 rondes, samen ~20 min. Levert stofwisselingsaanpassingen op vergelijkbaar met veel langere matige training."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nomeado em homenagem às pesquisas de Martin Gibala sobre intervalos de sprint. 60 s de esforço forte alternam com 60 s de recuperação por 8 rodadas, totalizando ~20 min. Gera adaptações metabólicas comparáveis a treinos moderados muito mais longos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以 Martin Gibala 的冲刺间歇研究命名。60 秒高强度与 60 秒恢复交替进行 8 轮，共约 20 分钟。其代谢适应效果可媲美时间长得多的中等强度训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以 Martin Gibala 的衝刺間歇研究命名。60 秒高強度與 60 秒恢復交替進行 8 輪，共約 20 分鐘。其代謝適應效果可媲美時間長得多的中等強度訓練。"
          }
        }
      },
      "comment" : "UI text shown in: Interval Setup (Cadence/Cadence/Features/Intervals/IntervalSetupView.swift)"
    },
