        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaste rustdagen zijn dagen waarop de coach geen trainingen plant. Je kunt er op die dagen nog steeds handmatig een starten als je wilt."
