    "If you usually choose easier alternatives, Coach will lower this in the future." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du meist leichtere Alternativen wählst, senkt der Coach dies künftig."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "If you usually choose easier alternatives, Coach will lower this in the future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si sueles elegir alternativas más fáciles, el Coach lo bajará en el futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous choisissez souvent des alternatives plus faciles, le Coach l’abaissera à l’avenir."
