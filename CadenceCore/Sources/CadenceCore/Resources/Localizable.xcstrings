    "Build an aerobic base: 20–30 min of easy-to-moderate work (brisk walk, light cycle, easy swim) a couple of times a week. Progress duration before intensity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baue eine Ausdauerbasis auf: 20–30 Min. lockere bis moderate Belastung (zügiges Gehen, leichtes Radfahren, lockeres Schwimmen) ein paar Mal pro Woche. Steigere erst die Dauer, dann die Intensität."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Build an aerobic base: 20–30 min of easy-to-moderate work (brisk walk, light cycle, easy swim) a couple of times a week. Progress duration before intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea una base aeróbica: 20–30 min de trabajo suave a moderado (caminar rápido, pedalear suave, nadar tranquilo) un par de veces por semana. Aumenta la duración antes que la intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Construisez une base aérobie : 20–30 min d’effort léger à modéré (marche rapide, vélo tranquille, nage facile) quelques fois par semaine. Augmentez la durée avant l’intensité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bouw een aerobe basis op: 20–30 min rustige tot matige inspanning (stevig wandelen, rustig fietsen, ontspannen zwemmen) een paar keer per week. Verleng eerst de duur, dan de intensiteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Construa uma base aeróbica: 20–30 min de esforço leve a moderado (caminhada rápida, pedal leve, natação tranquila) algumas vezes por semana. Aumente a duração antes da intensidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打好有氧基础：每周几次 20–30 分钟轻松到中等强度的活动（快走、轻松骑车、轻松游泳）。先增加时长，再提高强度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打好有氧基礎：每週幾次 20–30 分鐘輕鬆到中等強度的活動（快走、輕鬆騎車、輕鬆游泳）。先增加時長，再提高強度。"
          }
        }
      },
      "comment" : "UI text shown in: Coach Rule Support (CadenceCore/Sources/CadenceCore/CoachRuleSupport.swift)"
    },
