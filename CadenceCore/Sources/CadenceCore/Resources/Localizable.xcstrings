    "Build your aerobic base: try 20–30 min of moderate work (brisk walk, light cycle, or easy swim) 2–3 times a week. Progress duration before intensity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baue deine Ausdauerbasis auf: Probiere 2–3 Mal pro Woche 20–30 Min. moderate Belastung (zügiges Gehen, leichtes Radfahren oder lockeres Schwimmen). Steigere erst die Dauer, dann die Intensität."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Build your aerobic base: try 20–30 min of moderate work (brisk walk, light cycle, or easy swim) 2–3 times a week. Progress duration before intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea tu base aeróbica: prueba 20–30 min de trabajo moderado (caminar rápido, pedalear suave o nadar tranquilo) 2–3 veces por semana. Aumenta la duración antes que la intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Construisez votre base aérobie : essayez 20–30 min d’effort modéré (marche rapide, vélo tranquille ou nage facile) 2 à 3 fois par semaine. Augmentez la durée avant l’intensité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bouw je aerobe basis op: probeer 2–3 keer per week 20–30 min matige inspanning (stevig wandelen, rustig fietsen of ontspannen zwemmen). Verleng eerst de duur, dan de intensiteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Construa sua base aeróbica: experimente 20–30 min de esforço moderado (caminhada rápida, pedal leve ou natação tranquila) 2–3 vezes por semana. Aumente a duração antes da intensidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打好有氧基础：每周 2–3 次，尝试 20–30 分钟中等强度活动（快走、轻松骑车或轻松游泳）。先增加时长，再提高强度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打好有氧基礎：每週 2–3 次，嘗試 20–30 分鐘中等強度活動（快走、輕鬆騎車或輕鬆游泳）。先增加時長，再提高強度。"
          }
        }
      },
      "comment" : "UI text shown in: Recommendation Rule (CadenceCore/Sources/CadenceCore/RecommendationRule.swift)"
    },
