    "You already lifted today. Another session means recovery, not more strength, will be the limiting factor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du hast heute schon Krafttraining gemacht. Bei einer weiteren Einheit wird die Erholung, nicht mehr Kraft, der begrenzende Faktor sein."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You already lifted today. Another session means recovery, not more strength, will be the limiting factor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ya has entrenado fuerza hoy. Otra sesión significa que el factor limitante será la recuperación, no ganar más fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
