    "The version and build above identify the Watch binary currently installed. Phone reachability must say Reachable before Sync now can send a live request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Version und Build oben kennzeichnen die aktuell installierte Watch-App. „iPhone-Erreichbarkeit“ muss „Erreichbar“ anzeigen, bevor „Jetzt synchronisieren“ eine Live-Anfrage senden kann."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
