    "Add a steady-hard effort: e.g. 2×10 min or 20 min continuous at a 'comfortably hard' pace you could just hold a few words at." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge eine zügig-harte Einheit hinzu: z. B. 2×10 Min. oder 20 Min. am Stück in einem „angenehm harten“ Tempo, bei dem du gerade noch ein paar Worte sagen kannst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Add a steady-hard effort: e.g. 2×10 min or 20 min continuous at a 'comfortably hard' pace you could just hold a few words at."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade un esfuerzo constante y exigente: p. ej., 2×10 min o 20 min seguidos a un ritmo «cómodamente duro» en el que apenas puedas decir unas palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez un effort soutenu : par ex. 2×10 min ou 20 min en continu à une allure « confortablement difficile » où vous pouvez tout juste dire quelques mots."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg een stevige duurinspanning toe: bijv. 2×10 min of 20 min aaneen in een ‘comfortabel zwaar’ tempo waarbij je nog net een paar woorden kunt zeggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione um esforço constante e puxado: por exemplo, 2×10 min ou 20 min contínuos num ritmo “confortavelmente difícil”, em que você mal consegue dizer algumas palavras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "增加一次稳定偏难的训练：例如 2×10 分钟，或连续 20 分钟，保持“舒适但吃力”的配速，只能勉强说几个字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "增加一次穩定偏難的訓練：例如 2×10 分鐘，或連續 20 分鐘，維持「舒適但吃力」的配速，只能勉強說幾個字。"
          }
        }
      },
