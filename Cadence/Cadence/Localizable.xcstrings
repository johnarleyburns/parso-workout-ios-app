          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si una sugerencia no te encaja, elige No sugerir este ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si une suggestion ne vous convient pas, choisissez Ne plus suggérer cet exercice."
